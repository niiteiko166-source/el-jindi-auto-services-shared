# Production Environment Configuration
# Copy this file to .env and fill in actual values for production deployment

# Node Environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database (Prisma Postgres)
# Copy the pooled Prisma Postgres connection string from the Prisma Console.
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# Maximum PostgreSQL connections per server instance. Use 1 on Vercel.
PG_POOL_MAX=1

# JWT Secret for authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Application Settings
APP_VERSION=1.0.0
APP_NAME=EL-JINDI Auto Services
APP_URL=http://localhost:3000

# Optional: External Service Integrations
# Leave empty to disable WhatsApp and DVLA features

# WhatsApp Integration (optional)
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# DVLA API Integration (optional)
DVLA_API_URL=
DVLA_API_KEY=
