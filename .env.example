# Application
NODE_ENV=production
PORT=3000

# PostgreSQL connection used by the application
DATABASE_URL=postgresql://eljindi_app:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/eljindi
DATABASE_FILE=./data/app.sqlite
BUSINESS_STORE_PATH=./data/db.json
BACKUP_DIR=./backups
LOG_FILE=./logs/app.log

# Authentication secrets. Generate unique values; never commit them.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD

# Docker Compose variables
POSTGRES_USER=eljindi_app
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=eljindi
